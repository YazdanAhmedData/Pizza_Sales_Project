                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Semibold' underline='true'>HOURS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffbe7d' fontname='Tableau Semibold' fontsize='8'>PEAK ORDERS ARE BETWEEN</run>
                    <run fontalignment='1' fontcolor='#f28e2b' fontname='Tableau Semibold' fontsize='8'>Æ </run>
                    <run fontalignment='1' fontcolor='#75a1c7' fontname='Tableau Semibold' fontsize='8'>12:00 PM AND 1:00 PM</run>
                    <run fontalignment='1' fontcolor='#f28e2b' fontname='Tableau Semibold' fontsize='8'>, </run>
                    <run fontalignment='1' fontcolor='#ffbe7d' fontname='Tableau Semibold' fontsize='8'>AND </run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffbe7d' fontname='Tableau Semibold' fontsize='8'>IN EVENING FROM</run>
                    <run fontalignment='1' fontcolor='#75a1c7' fontname='Tableau Semibold' fontsize='8'> 4:00PM TO 7:00PM </run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Semibold' underline='true'>WEEKS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffbe7d' fontname='Tableau Semibold' fontsize='8'>SIGNIFICANT VARIATIONS IN WEEKLY ORDERS , </run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffbe7d' fontname='Tableau Semibold'>WITH </run>
                    <run fontalignment='1' fontcolor='#75a1c7' fontname='Tableau Semibold'>HIGHEST PEAK DURING THE 48TH WEEK</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ffbe7d' fontname='Tableau Semibold'>FROM THE MONTH OF DE</run>
                    <run fontalignment='1' fontcolor='#ffbe7d' fontname='Tableau Semibold' fontsize='10'>C</run>
