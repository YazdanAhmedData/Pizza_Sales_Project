            <column caption='Total Orders' datatype='integer' name='[Calculation_0072329114550273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='Total Pizzas Sold' datatype='integer' name='[Calculation_0072329115062275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([quantity])' />
            </column>
            <column caption='Negative Total Pizzas sold' datatype='integer' name='[Calculation_0072329576669197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- [Calculation_0072329115062275]' />
